{
  "name": "bribooks-backend",
  "version": "1.0.0",
  "description": "BriBooks Microservices Backend - Children's Book Authoring Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:user\" \"npm run dev:book\" \"npm run dev:ai\" \"npm run dev:safety\" \"npm run dev:publishing\" \"npm run dev:payment\" \"npm run dev:notification\" \"npm run dev:admin\"",
    "dev:gateway": "npm run dev --workspace=services/api-gateway",
    "dev:user": "npm run dev --workspace=services/user-service",
    "dev:book": "npm run dev --workspace=services/book-authoring-service",
    "dev:ai": "npm run dev --workspace=services/ai-orchestrator-service",
    "dev:safety": "npm run dev --workspace=services/safety-service",
    "dev:publishing": "npm run dev --workspace=services/publishing-service",
    "dev:payment": "npm run dev --workspace=services/payment-service",
    "dev:notification": "npm run dev --workspace=services/notification-service",
    "dev:admin": "npm run dev --workspace=services/admin-service",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "npm run db:migrate --workspace=packages/database",
    "db:seed": "npm run db:seed --workspace=packages/database",
    "db:studio": "npm run db:studio --workspace=packages/database",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
